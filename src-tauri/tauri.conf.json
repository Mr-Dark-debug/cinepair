{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CinePair",
  "version": "0.1.8",
  "identifier": "com.cinepair.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/app.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CinePair",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "url": "app.html",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 16 },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Watch movies together in sync",
    "longDescription": "CinePair is a couples-first co-watch cinema: synced watch party, encrypted chat, pixel avatars, PiP and doodles over peer-to-peer video.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Mr-Dark-debug/cinepair/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3QkRGMDk4MDE3M0JCODQKUldTRXUzTUJtUEM5dDFtaVo5NlYwV2hpU1VMK1dpanNueU5kcmtHeEl1RjAyK2FyM2pvbEVBVEsK"
    }
  }
}
